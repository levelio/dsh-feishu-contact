{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": false,
    "outDir": "lib/host",
    "rootDir": "src/host",
    "types": ["node"],
    "useDefineForClassFields": true,
    "experimentalDecorators": false,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src/host/**/*.ts"]
}
