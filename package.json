{
  "name": "dsh-feishu-contact",
  "version": "0.1.0",
  "description": "在 DeepSeek Harness 里 @ 飞书联系人和群：以你的身份发消息、读会话。",
  "type": "module",
  "license": "MIT",
  "author": "ZhiqiangHe <simlesos@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levelio/dsh-feishu-contact.git"
  },
  "homepage": "https://github.com/levelio/dsh-feishu-contact#readme",
  "bugs": {
    "url": "https://github.com/levelio/dsh-feishu-contact/issues"
  },
  "main": "lib/host/index.js",
  "exports": {
    ".": "./lib/host/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "DESIGN.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "feishu",
    "lark"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.1-rc.2",
    "@deepseek-ai/schemastery": ">=3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "prepare": "node build.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.5",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/node": "22.20.5",
    "@types/react": "^19.3.0",
    "esbuild": "0.28.2",
    "pinyin-pro": "^3.29.5",
    "typescript": "6.0.3"
  }
}
